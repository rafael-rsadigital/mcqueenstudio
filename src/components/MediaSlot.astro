---
const { src, type = 'image', alt = 'Mídia real da Mcqueen Studio', label = 'Mídia real pendente', className = '', loading = 'lazy' } = Astro.props;
---
<div class={`media-slot ${className}`} data-media-slot>
  {type === 'video' ? <video src={src} muted playsinline loop preload="metadata" aria-label={alt}></video> : <img src={src} alt={alt} loading={loading} decoding="async" fetchpriority={loading === "eager" ? "high" : "auto"} width="1600" height="1100" onerror="this.style.display='none'" />}
  <div class="media-slot-note"><span class="media-pulse"></span><strong>{label}</strong><small>{src}</small></div>
</div>
<script is:inline>
  document.querySelectorAll('[data-media-slot]').forEach((slot) => {
    const media = slot.querySelector('img, video');
    const note = slot.querySelector('.media-slot-note');
    const show = () => { media?.style.setProperty('opacity', '1'); if (note) note.style.display = 'none'; };
    media?.addEventListener('load', show, { once: true });
    media?.addEventListener('loadeddata', show, { once: true });
    if (media?.tagName === 'IMG' && media.complete && media.naturalWidth) show();
  });
</script>
