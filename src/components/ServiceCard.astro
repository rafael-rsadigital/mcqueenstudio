---
const { service } = Astro.props;
---
<article class="service-card"><div class="service-card-top"><span>{service.number}</span><span>↗</span></div><div><p class="eyebrow">{service.eyebrow}</p><h3>{service.title}</h3><p>{service.short}</p><a class="text-link" href={`/${service.slug}/`}>Explorar serviço <span>↗</span></a></div></article>
