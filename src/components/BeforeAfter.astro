<section class="before-after gallery-comparison" aria-labelledby="before-after-title">
  <div class="comparison-heading"><p class="eyebrow">Comparador de projeto</p><h2 id="before-after-title">Antes e depois</h2></div>
  <div class="comparison" data-comparison tabindex="0" role="slider" aria-label="Comparador de imagem antes e depois" aria-valuemin="3" aria-valuemax="97" aria-valuenow="50">
    <div class="comparison-side comparison-before"><img src="/media/comparador/projeto-01-antes.jpg" alt="Veículo antes do trabalho realizado pela Mcqueen Studio" loading="eager" /></div>
    <div class="comparison-side comparison-after"><img src="/media/comparador/projeto-01-depois.jpg" alt="Veículo depois do trabalho realizado pela Mcqueen Studio" loading="eager" /></div>
    <span class="comparison-label comparison-label-before">Antes</span><span class="comparison-label comparison-label-after">Depois</span>
    <div class="comparison-handle" data-comparison-handle aria-hidden="true"><span>↔</span></div>
  </div>
</section>
<script is:inline>
  const comparison = document.querySelector('[data-comparison]');
  if (comparison) {
    let dragging = false;
    const move = (event) => {
      const point = event.touches?.[0] || event;
      const rect = comparison.getBoundingClientRect();
      const percent = Math.max(3, Math.min(97, ((point.clientX - rect.left) / rect.width) * 100));
      comparison.style.setProperty('--split', percent + '%');
      comparison.setAttribute('aria-valuenow', String(Math.round(percent)));
    };
    comparison.addEventListener('pointerdown', (event) => { dragging = true; comparison.setPointerCapture?.(event.pointerId); move(event); });
    comparison.addEventListener('pointermove', (event) => { if (dragging) move(event); });
    comparison.addEventListener('pointerup', () => { dragging = false; });
    comparison.addEventListener('pointercancel', () => { dragging = false; });
    comparison.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        const current = parseFloat(getComputedStyle(comparison).getPropertyValue('--split')) || 50;
        const next = Math.max(3, Math.min(97, current + (event.key === 'ArrowRight' ? 4 : -4)));
        comparison.style.setProperty('--split', next + '%');
        comparison.setAttribute('aria-valuenow', String(Math.round(next)));
      }
    });
  }
</script>
