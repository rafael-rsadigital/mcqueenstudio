<section class="before-after block-dark" aria-labelledby="before-after-title">
  <div class="wrap"><div class="section-heading"><p class="eyebrow">Comparador de projeto</p><h2 id="before-after-title">Antes e depois, sem atalhos.</h2><p>Este componente está pronto para receber duas fotos reais do mesmo projeto. Insira os arquivos indicados e substitua os caminhos no componente.</p></div>
  <div class="comparison" data-comparison tabindex="0" aria-label="Comparador antes e depois"><div class="comparison-side comparison-before"><div class="comparison-placeholder"><span>ANTES</span><small>/media/comparador/projeto-01-antes.jpg</small></div></div><div class="comparison-side comparison-after"><div class="comparison-placeholder"><span>DEPOIS</span><small>/media/comparador/projeto-01-depois.jpg</small></div></div><div class="comparison-handle" data-comparison-handle><span>↔</span></div></div></div>
</section>
<script is:inline>
  const comparison = document.querySelector('[data-comparison]'); const handle = document.querySelector('[data-comparison-handle]');
  if (comparison && handle) { let dragging = false; const move = (event) => { const point = event.touches?.[0] || event; const rect = comparison.getBoundingClientRect(); const percent = Math.max(3, Math.min(97, ((point.clientX - rect.left) / rect.width) * 100)); comparison.style.setProperty('--split', `${percent}%`); }; comparison.addEventListener('pointerdown', (event) => { dragging = true; comparison.setPointerCapture?.(event.pointerId); move(event); }); comparison.addEventListener('pointermove', (event) => dragging && move(event)); comparison.addEventListener('pointerup', () => dragging = false); comparison.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') { event.preventDefault(); const current = parseFloat(getComputedStyle(comparison).getPropertyValue('--split')) || 50; comparison.style.setProperty('--split', `${Math.max(3, Math.min(97, current + (event.key === 'ArrowRight' ? 4 : -4)))}%`); } }); }
</script>
