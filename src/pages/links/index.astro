---
import { company, services, whatsappUrl } from '../../data/site.js';
import '../../styles/global.css';
import '../../styles/linktree.css';

const reviews = [
  { text: 'Fui com uma queimadura de soprador a qual achava que estava não tinha solução, porém a MC Queen muito profissional deixou meu farol novo de novo, excelentes profissionais da área e muito confiáveis no que faz', author: 'José de Alencar', date: '20 nov. 2022' },
  { text: 'Tooooopzera de sempre! Carro estava bem sujo, ficou ótimo e os detalhes da limpeza no logo da GM, nome do carro e na revitalização dos plásticos é fora de serioooooo!!!! Muito bom sempre contar com os serviços da Mcqueen. Tks irmão Lucas pelo padrão de sempre… Será sempre recomendado por mim….', author: 'Pedro Zago', date: '14 dez. 2022' },
  { text: 'Parabéns ao Lucas, da Mcqueen Estética Automotiva, excelente profissional, estou muito satisfeito com a instalação da câmera de Ré e o sensor para estacionar. Dedicação total, em cada detalhe e resposta imediata ao cliente, indico e dou nota 10.', author: 'Oliveira Reis', date: '21 dez. 2022' },
  { text: 'Excelente trabalho, fui para fazer somente a plotagem do teto e limpeza, porem o mesmo ja me ajudou com problema do teto descolando internamente e fez o acompanhamento do motor falhando, alem de auxiliar em outras melhorias esteticas. O carro quando saiu, saiu outro tanto internamente quanto externamente, praticamente novo, com estiloso, cheroso e potencia. Ainda ficamos de dar continuidade ao projeto, muito bom trabalho, cuidadoso e onesto.', author: 'Kelvim wellington', date: '03 fev. 2023' },
];
const googleReviewUrl = 'https://g.page/r/CelD1gSLiSFiEBM/review';
const mapEmbedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3619.5344336069847!2d-45.88774472468127!3d-23.196262079051714!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94cc4b8f9b528b2d%3A0x6221898b04d643e9!2sMcqueen%20Studio%20Automotivo%20I%20Polimento%20I%20Envelopamento%20I%20Polimento%20em%20Farol%20I%20PPF%20I%20SJC!5e1!3m2!1spt-BR!2sbr!4v1793916238289!5m2!1spt-BR!2sbr';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{company.shortName} | Links oficiais</title>
    <meta name="description" content="Links oficiais da Mcqueen Studio Automotivo: WhatsApp, serviços, site, Instagram, avaliações e localização em São José dos Campos." />
    <link rel="canonical" href="https://mcqueenstudio.vercel.app/links/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="linktree-page">
    <main class="linktree-shell">
      <header class="linktree-profile">
        <img class="linktree-logo" src="/media/logo/mcqueen-studio.png" alt="Mcqueen Studio Automotivo" width="2172" height="724" />
        <h1>Seu carro, com uma nova perspectiva.</h1>
      </header>

      <section class="linktree-actions" aria-label="Acessos rápidos">
        <a class="linktree-quick-link quick-whatsapp" href={whatsappUrl('um atendimento')} target="_blank" rel="noreferrer" aria-label="Conversar pelo WhatsApp">
          <span class="quick-icon" aria-hidden="true"><img src="/icons/whatsapp.svg" alt="" width="32" height="32" /></span>
          <span>WhatsApp</span>
        </a>
        <a class="linktree-quick-link quick-location" href="https://www.google.com/maps/search/?api=1&query=Mcqueen+Studio+Automotivo+Sao+Jose+dos+Campos" target="_blank" rel="noreferrer" aria-label="Ver localização no Google Maps">
          <span class="quick-icon" aria-hidden="true"><img src="/icons/google-maps.png" alt="" width="32" height="32" /></span>
          <span>Localização</span>
        </a>
        <a class="linktree-quick-link quick-google" href={googleReviewUrl} target="_blank" rel="noreferrer" aria-label="Avaliar a Mcqueen Studio no Google">
          <span class="quick-icon google-g" aria-hidden="true"><img src="/icons/google.svg" alt="" width="32" height="32" /></span>
          <span>Avaliar</span>
        </a>
        <a class="linktree-quick-link quick-instagram" href={company.instagram} target="_blank" rel="noreferrer" aria-label="Acessar Instagram da Mcqueen Studio">
          <span class="quick-icon" aria-hidden="true"><img src="/icons/instagram.svg" alt="" width="32" height="32" /></span>
          <span>Instagram</span>
        </a>
      </section>
      <a class="linktree-site-link" href="/">Conheça o site completo <span>↗</span></a>
      <a class="linktree-course-link" href="https://pay.hotmart.com/G97791543R?off=eh99yfr3&utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAZXh0bgNhZW0CMTEAcGRvZgJzcnRjBmFwcF9pZA85MzY2MTk3NDMzOTI0NTkAAaf2dOw4nWLybxZYuDg-RzkctnTr3WHBMNg4TMjQZ7a6MAeaqFh7GMCC8z-wug_aem_hPi89jdJ9GxUVKtKizqg6Q&bid=1793917666228" target="_blank" rel="noopener noreferrer">
        <span class="course-link-icon" aria-hidden="true">▶</span>
        <span class="course-link-copy"><small>Curso online</small><strong>Envelopando com Mcqueen</strong><em>Técnica do Envelopamento Automotivo</em></span>
        <span class="course-link-arrow" aria-hidden="true">↗</span>
      </a>

      <section class="linktree-section linktree-services-section" aria-labelledby="linktree-services-title">
        <details class="linktree-services-disclosure">
          <summary><span class="services-summary-icon" aria-hidden="true">✦</span><span class="services-summary-copy"><strong id="linktree-services-title">Nossos serviços</strong><small>Conheça tudo o que fazemos</small></span><span class="services-summary-action">Ver serviços <i aria-hidden="true">⌄</i></span></summary>
          <div class="linktree-services">{services.map((service) => <a href={whatsappUrl(service.title)} target="_blank" rel="noopener noreferrer" class="linktree-service" aria-label={`Consultar sobre ${service.title} pelo WhatsApp`}><span>{service.number}</span><strong>{service.title}</strong><i>↗</i></a>)}</div>
        </details>
      </section>

      <section class="linktree-section linktree-reviews" aria-labelledby="linktree-reviews-title">
        <div class="linktree-section-heading"><span>02 / Avaliações</span><h2 id="linktree-reviews-title">Quem já passou por aqui.</h2><p><strong>5,0</strong> de 5 · {company.reviews} avaliações no <b class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></b></p></div>
        <div class="linktree-review-viewport" data-linktree-reviews><div class="linktree-review-track">{reviews.map((review) => <article class="linktree-review"><div class="linktree-review-top"><span aria-label="5 de 5 estrelas">★★★★★</span><b class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></b></div><blockquote>“{review.text}”</blockquote><footer><strong>{review.author}</strong><time>{review.date}</time></footer></article>)}</div></div>
        <div class="linktree-review-controls" data-linktree-controls aria-label="Navegação dos depoimentos"></div>
      </section>

      <section class="linktree-section linktree-map-section" aria-labelledby="linktree-map-title">
        <div class="linktree-section-heading"><span>03 / Localização</span><h2 id="linktree-map-title">Encontre a Mcqueen Studio.</h2><p>{company.address}</p></div>
        <div class="linktree-map"><iframe src={mapEmbedUrl} title="Mapa da Mcqueen Studio Automotivo" width="600" height="450" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
        <a class="linktree-button linktree-button-map" href="https://www.google.com/maps/search/?api=1&query=Mcqueen+Studio+Automotivo+Sao+Jose+dos+Campos" target="_blank" rel="noreferrer"><span class="link-icon">↗</span><span>Abrir rota no Google Maps</span></a>
      </section>

      <footer class="linktree-footer"><span>Mcqueen Studio Automotivo</span><span>{company.city}</span></footer>
    </main>
    <script is:inline>
      (() => {
        const viewport = document.querySelector('[data-linktree-reviews]');
        const track = viewport?.querySelector('.linktree-review-track');
        const controls = document.querySelector('[data-linktree-controls]');
        if (!viewport || !track || !controls) return;
        let index = 0;
        const go = (next) => { index = (next + track.children.length) % track.children.length; viewport.scrollTo({ left: track.children[index].offsetLeft - track.offsetLeft, behavior: 'smooth' }); [...controls.children].forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === index)); };
        [...track.children].forEach((_, reviewIndex) => { const dot = document.createElement('button'); dot.type = 'button'; dot.className = 'linktree-dot'; dot.setAttribute('aria-label', `Mostrar depoimento ${reviewIndex + 1}`); dot.addEventListener('click', () => go(reviewIndex)); controls.append(dot); });
        let timer = setInterval(() => go(index + 1), 6500);
        viewport.addEventListener('pointerdown', () => clearInterval(timer));
        viewport.addEventListener('pointerup', () => { clearInterval(timer); timer = setInterval(() => go(index + 1), 6500); });
        go(0);
      })();
    </script>
  </body>
</html>
