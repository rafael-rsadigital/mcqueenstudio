---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, blogCategories } from '../../data/blog.js';
const featured = blogPosts[0];
const remaining = blogPosts.slice(1);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog Mcqueen Studio',
  description: 'Conteúdos sobre estética, proteção e personalização automotiva.',
  url: 'https://www.mcqueenstudio.com.br/blog/',
  publisher: { '@type': 'Organization', name: 'Mcqueen Studio Automotivo', url: 'https://www.mcqueenstudio.com.br/' }
};
---
<BaseLayout title="Blog de Estética Automotiva em São José dos Campos" description="Dicas e informações sobre PPF, polimento, vitrificação, envelopamento e cuidados automotivos. Conteúdo da Mcqueen Studio, em São José dos Campos." path="/blog/" image="/media/entrada/envelopamento-do-teto.jpeg" schema={schema} breadcrumbs={['Blog']}>
  <section class="blog-hero">
    <div class="wrap blog-hero-inner">
      <p class="eyebrow">Conhecimento automotivo · Mcqueen Studio</p>
      <h1>Cuide melhor do seu carro.<br /><span>Escolha com informação.</span></h1>
      <p>Conteúdos sobre estética, proteção e personalização automotiva para ajudar você a entender cada serviço e decidir o que faz sentido para o seu veículo.</p>
    </div>
  </section>
  <section class="blog-featured wrap">
    <a class="blog-feature-image" href={`/blog/${featured.slug}/`}>
      <img src={featured.image} alt={featured.imageAlt} loading="eager" fetchpriority="high" />
      <span class="image-label">Artigo em destaque</span>
    </a>
    <div class="blog-feature-copy">
      <p class="eyebrow">{featured.category} · {featured.readTime}</p>
      <h2><a href={`/blog/${featured.slug}/`}>{featured.title}</a></h2>
      <p>{featured.description}</p>
      <a class="blog-read-link" href={`/blog/${featured.slug}/`}>Ler artigo <span>↗</span></a>
    </div>
  </section>
  <section class="blog-list-section">
    <div class="wrap">
      <div class="blog-section-heading">
        <div><p class="eyebrow">Explore os conteúdos</p><h2>Artigos e orientações</h2></div>
        <span class="blog-count">06 PUBLICAÇÕES</span>
      </div>
      <div class="blog-categories">
        {blogCategories.map((category) => <a href={`#${category.slug}`}>{category.label}<span>↘</span></a>)}
      </div>
      {blogCategories.map((category) => {
        const posts = remaining.filter((post) => post.categorySlug === category.slug);
        return <section class="blog-category-block" id={category.slug}>
          <div class="blog-category-title"><h3>{category.label}</h3><span>{String(posts.length).padStart(2, '0')} artigos</span></div>
          <div class="blog-grid">
            {posts.map((post) => <article class="blog-card">
              <a class="blog-card-image" href={`/blog/${post.slug}/`}><img src={post.image} alt={post.imageAlt} loading="lazy" /><span>LER ARTIGO ↗</span></a>
              <div class="blog-card-copy">
                <p class="eyebrow">{post.category} · {post.readTime}</p>
                <h4><a href={`/blog/${post.slug}/`}>{post.title}</a></h4>
                <p>{post.description}</p>
                <a class="blog-read-link" href={`/blog/${post.slug}/`}>Continuar leitura <span>↗</span></a>
              </div>
            </article>)}
          </div>
        </section>;
      })}
    </div>
  </section>
  <section class="blog-bottom-cta">
    <div class="wrap blog-bottom-inner"><div><p class="eyebrow">Seu próximo cuidado começa com uma avaliação</p><h2>Quer entender o que faz sentido para o seu veículo?</h2><p>Converse com a Mcqueen Studio e tire suas dúvidas sobre os serviços disponíveis.</p></div><a class="blog-cta-button" href="https://wa.me/5512981460442?text=Ol%C3%A1%21%20Vim%20pelo%20blog%20da%20Mcqueen%20Studio%20e%20gostaria%20de%20tirar%20uma%20d%C3%BAvida." target="_blank" rel="noreferrer">Conversar pelo WhatsApp <span>↗</span></a></div>
  </section>
</BaseLayout>
<style>
.blog-hero{background:radial-gradient(ellipse at 78% 15%,rgba(164,25,32,.18),transparent 38%),#09090b;padding:clamp(76px,10vw,132px) 0 82px;border-bottom:1px solid #242428}.blog-hero-inner{max-width:1180px}.blog-hero .eyebrow,.eyebrow{color:#e34b50;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;font-weight:800}.blog-hero h1{font:700 clamp(2.8rem,6.5vw,6.3rem)/.99 'Space Grotesk',sans-serif;letter-spacing:-.065em;max-width:1000px;margin:22px 0}.blog-hero h1 span{color:#aeb0b5}.blog-hero-inner>p:last-child{max-width:680px;color:#b6b7bc;font-size:1.05rem;line-height:1.8;margin:26px 0 0}.blog-featured{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(28px,5vw,72px);align-items:center;padding-top:76px;padding-bottom:78px}.blog-feature-image{position:relative;display:block;overflow:hidden;aspect-ratio:16/9;background:#19191c}.blog-feature-image img,.blog-card-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s}.blog-feature-image:hover img,.blog-card-image:hover img{transform:scale(1.035)}.image-label{position:absolute;left:18px;bottom:18px;background:#a51e25;color:#fff;padding:9px 13px;font-size:.66rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.blog-feature-copy h2{font:700 clamp(2rem,3.2vw,3.4rem)/1.08 'Space Grotesk',sans-serif;letter-spacing:-.045em;margin:17px 0}.blog-feature-copy h2 a,.blog-card h4 a{color:inherit;text-decoration:none}.blog-feature-copy>p:not(.eyebrow){color:#aeb0b5;line-height:1.8}.blog-read-link{display:inline-flex;gap:14px;align-items:center;color:#fff;text-decoration:none;font-weight:800;font-size:.88rem;margin-top:18px}.blog-read-link span{color:#e34b50}.blog-list-section{background:#f3f3f1;color:#171719;padding:78px 0 100px}.blog-section-heading,.blog-category-title{display:flex;align-items:end;justify-content:space-between;gap:20px}.blog-section-heading h2{font:700 clamp(2rem,4vw,3.5rem)/1.05 'Space Grotesk',sans-serif;letter-spacing:-.05em;margin:12px 0 0}.blog-section-heading .eyebrow,.blog-category-block .eyebrow{color:#a51e25}.blog-count,.blog-category-title span{font-size:.68rem;letter-spacing:.12em;font-weight:800;color:#777;text-transform:uppercase}.blog-categories{display:flex;gap:10px;flex-wrap:wrap;margin:30px 0 52px}.blog-categories a{border:1px solid #d3d3d0;border-radius:99px;padding:10px 15px;color:#29292b;text-decoration:none;font-size:.8rem;font-weight:700}.blog-categories a span{color:#a51e25;margin-left:12px}.blog-category-block{margin-top:48px;scroll-margin-top:100px}.blog-category-title{border-bottom:1px solid #d7d7d4;padding-bottom:15px;margin-bottom:22px}.blog-category-title h3{font:700 1.35rem 'Space Grotesk',sans-serif;margin:0}.blog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.blog-card{background:#fff;display:grid;grid-template-columns:.9fr 1.1fr;min-height:260px}.blog-card-image{position:relative;display:block;overflow:hidden;min-height:100%;background:#222}.blog-card-image span{position:absolute;left:12px;bottom:12px;color:white;background:rgba(0,0,0,.72);padding:7px 9px;font-size:.6rem;font-weight:800;letter-spacing:.1em}.blog-card-copy{padding:22px;display:flex;flex-direction:column;align-items:flex-start}.blog-card-copy .eyebrow{font-size:.61rem;line-height:1.5}.blog-card h4{font:700 1.16rem/1.18 'Space Grotesk',sans-serif;letter-spacing:-.025em;margin:12px 0}.blog-card-copy>p:not(.eyebrow){font-size:.82rem;line-height:1.6;color:#68686c;margin:0}.blog-card .blog-read-link{color:#171719;font-size:.76rem;margin-top:auto;padding-top:14px}.blog-bottom-cta{background:#0a0a0c;padding:62px 0}.blog-bottom-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.blog-bottom-inner>div{max-width:680px}.blog-bottom-inner .eyebrow{color:#e34b50}.blog-bottom-inner h2{font:700 clamp(1.8rem,3.5vw,3rem)/1.08 'Space Grotesk',sans-serif;letter-spacing:-.04em;margin:12px 0}.blog-bottom-inner p:last-child{color:#aaa;line-height:1.7}.blog-cta-button{display:inline-flex;align-items:center;gap:18px;white-space:nowrap;background:#e7e7e7;color:#111;padding:16px 20px;text-decoration:none;font-weight:800;font-size:.85rem}.blog-cta-button span{color:#a51e25}
@media(max-width:900px){.blog-grid{grid-template-columns:1fr}.blog-card{min-height:230px}.blog-card-image{min-height:230px}}
@media(max-width:680px){.blog-hero{padding:76px 0 62px}.blog-featured{grid-template-columns:1fr;padding-top:44px;padding-bottom:52px;gap:25px}.blog-feature-copy h2{font-size:2rem}.blog-list-section{padding:58px 0 72px}.blog-section-heading{align-items:start;flex-direction:column}.blog-categories{margin:24px 0 38px}.blog-card{grid-template-columns:1fr}.blog-card-image{aspect-ratio:16/9;min-height:0}.blog-card-copy{padding:20px}.blog-bottom-inner{align-items:flex-start;flex-direction:column}.blog-cta-button{white-space:normal}.blog-category-title h3{font-size:1.1rem}}
</style>
