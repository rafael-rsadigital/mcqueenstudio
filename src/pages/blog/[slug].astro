---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogPosts, getPost } from '../../data/blog.js';
export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const canonical = `https://www.mcqueenstudio.com.br/blog/${post.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  image: new URL(post.image, 'https://www.mcqueenstudio.com.br').toString(),
  datePublished: post.date,
  dateModified: post.date,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Organization', name: 'Mcqueen Studio Automotivo', url: 'https://www.mcqueenstudio.com.br/' },
  publisher: { '@type': 'Organization', name: 'Mcqueen Studio Automotivo', url: 'https://www.mcqueenstudio.com.br/' },
  articleSection: post.category,
  inLanguage: 'pt-BR'
};
const relatedPosts = post.related.map((slug) => getPost(slug)).filter(Boolean);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } }))
};
---
<BaseLayout title={post.title} description={post.description} path={`/blog/${post.slug}/`} image={post.image} schema={schema} breadcrumbs={['Blog', post.title]}>
  <article class="article-page">
    <header class="article-header wrap">
      <a class="article-back" href="/blog/">← Voltar ao blog</a>
      <p class="eyebrow">{post.category} <span>·</span> {post.readTime}</p>
      <h1>{post.title}</h1>
      <p class="article-intro">{post.intro}</p>
      <div class="article-meta"><span>Mcqueen Studio Automotivo</span><span>Atualizado em {new Date(post.date + 'T12:00:00').toLocaleDateString('pt-BR')}</span></div>
    </header>
    <figure class="article-cover wrap"><img src={post.image} alt={post.imageAlt} fetchpriority="high" /><figcaption>{post.imageAlt}</figcaption></figure>
    <div class="article-layout wrap">
      <div class="article-content">
        {post.sections.map((section) => <section class="article-section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
        </section>)}
        <section class="article-faq">
          <h2>Dúvidas frequentes</h2>
          {post.faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}
        </section>
        <section class="article-contact">
          <p class="eyebrow">Mcqueen Studio · São José dos Campos</p>
          <h2>Quer avaliar esse serviço para o seu veículo?</h2>
          <p>Converse com a equipe para entender as possibilidades, os cuidados e a indicação para o seu carro.</p>
          <a href={`https://wa.me/5512981460442?text=${encodeURIComponent('Olá! Li o artigo “' + post.title + '” no blog da Mcqueen Studio e gostaria de tirar uma dúvida.')}`} target="_blank" rel="noreferrer">Falar pelo WhatsApp <span>↗</span></a>
          <a class="service-link" href={post.service}>Conhecer o serviço relacionado <span>→</span></a>
        </section>
      </div>
      <aside class="article-aside">
        <p class="eyebrow">Neste artigo</p>
        <strong>{post.title}</strong>
        <a href="/blog/">Ver todos os artigos <span>↗</span></a>
        <div class="aside-note"><span>MCQUEEN STUDIO</span><p>Estética, proteção e personalização automotiva em São José dos Campos.</p></div>
      </aside>
    </div>
    {relatedPosts.length > 0 && <section class="related-section"><div class="wrap"><p class="eyebrow">Continue explorando</p><h2>Leia também</h2><div class="related-grid">{relatedPosts.map((related) => <a class="related-card" href={`/blog/${related.slug}/`}><img src={related.image} alt={related.imageAlt} loading="lazy" /><div><span>{related.category}</span><h3>{related.title}</h3><b>Continuar leitura ↗</b></div></a>)}</div><a class="all-articles" href="/blog/">← Todos os artigos</a></div></section>}
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
<style>
.article-page{background:#0a0a0c;color:#f4f4f2}.article-header{max-width:980px;padding-top:66px;padding-bottom:42px}.article-back{display:inline-block;color:#aaa;text-decoration:none;font-size:.8rem;margin-bottom:38px}.article-header .eyebrow,.article-content .eyebrow,.related-section .eyebrow{color:#e34b50;font-size:.7rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.article-header h1{font:700 clamp(2.45rem,5.5vw,5.2rem)/1.03 'Space Grotesk',sans-serif;letter-spacing:-.06em;margin:18px 0 22px;max-width:960px}.article-header .eyebrow span{color:#777;margin:0 8px}.article-intro{font-size:clamp(1.05rem,1.8vw,1.25rem);line-height:1.75;color:#bfc0c4;max-width:820px}.article-meta{display:flex;gap:22px;flex-wrap:wrap;border-top:1px solid #2b2b2e;margin-top:28px;padding-top:16px;color:#898a90;font-size:.72rem}.article-cover{max-width:1180px;margin:0 auto 68px}.article-cover img{width:100%;height:clamp(250px,48vw,590px);object-fit:cover;display:block}.article-cover figcaption{color:#777;font-size:.68rem;margin-top:9px}.article-layout{display:grid;grid-template-columns:minmax(0,760px) 260px;gap:clamp(40px,7vw,100px);justify-content:center;padding-bottom:88px}.article-content{min-width:0}.article-section{margin-bottom:42px}.article-section h2,.article-faq h2,.article-contact h2{font:700 clamp(1.5rem,2.8vw,2.2rem)/1.15 'Space Grotesk',sans-serif;letter-spacing:-.035em;margin:0 0 18px}.article-section p,.article-faq details p,.article-contact>p:not(.eyebrow){font-size:1rem;line-height:1.9;color:#c0c0c4;margin:0 0 17px}.article-section ul{padding-left:22px;color:#c0c0c4;line-height:1.9}.article-section li{padding-left:4px;margin:6px 0}.article-aside{align-self:start;position:sticky;top:110px;border-left:1px solid #343438;padding-left:22px;color:#bdbdc2}.article-aside .eyebrow{font-size:.65rem;letter-spacing:.13em;color:#e34b50}.article-aside strong{display:block;font:600 1rem/1.4 'Space Grotesk',sans-serif;color:#fff;margin:14px 0 20px}.article-aside>a{color:#fff;text-decoration:none;font-size:.78rem;font-weight:700}.article-aside>a span{color:#e34b50}.aside-note{border-top:1px solid #343438;margin-top:34px;padding-top:18px}.aside-note span{font-size:.62rem;letter-spacing:.14em;color:#e34b50;font-weight:800}.aside-note p{font-size:.78rem;line-height:1.7;color:#8f9095}.article-faq{margin:58px 0}.article-faq details{border-top:1px solid #303034;padding:17px 0}.article-faq details:last-child{border-bottom:1px solid #303034}.article-faq summary{cursor:pointer;list-style:none;font-weight:700;color:#eee;line-height:1.5}.article-faq summary::-webkit-details-marker{display:none}.article-faq summary:after{content:'+';float:right;color:#e34b50;font-size:1.2rem}.article-faq details[open] summary:after{content:'−'}.article-faq details p{margin:12px 28px 0 0;font-size:.9rem}.article-contact{background:#171719;border:1px solid #303034;padding:30px;margin-top:62px}.article-contact .eyebrow{font-size:.65rem}.article-contact h2{margin:12px 0}.article-contact>p:not(.eyebrow){font-size:.9rem}.article-contact>a{display:inline-flex;gap:16px;align-items:center;background:#eee;color:#111;padding:14px 17px;text-decoration:none;font-size:.8rem;font-weight:800;margin-top:8px}.article-contact>a span{color:#a51e25}.article-contact>a.service-link{background:transparent;color:#ddd;border:1px solid #4a4a4d;margin-left:8px}.related-section{background:#f1f1ef;color:#171719;padding:70px 0}.related-section h2{font:700 clamp(2rem,4vw,3rem) 'Space Grotesk',sans-serif;letter-spacing:-.04em;margin:10px 0 28px}.related-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.related-card{display:grid;grid-template-columns:160px 1fr;background:#fff;color:#171719;text-decoration:none;min-height:150px}.related-card img{width:100%;height:100%;object-fit:cover}.related-card div{padding:18px}.related-card span{font-size:.62rem;color:#a51e25;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.related-card h3{font:700 1rem/1.2 'Space Grotesk',sans-serif;margin:9px 0}.related-card b{font-size:.7rem}.all-articles{display:inline-block;margin-top:28px;color:#222;text-decoration:none;font-size:.8rem;font-weight:800}
@media(max-width:900px){.article-layout{grid-template-columns:1fr}.article-aside{display:none}}
@media(max-width:680px){.article-header{padding-top:42px;padding-bottom:28px}.article-back{margin-bottom:26px}.article-header h1{font-size:2.45rem}.article-cover{margin-bottom:42px}.article-cover img{height:260px}.article-layout{padding-bottom:60px}.article-section p,.article-faq details p{font-size:.94rem}.article-contact{padding:22px}.article-contact>a.service-link{margin-left:0}.related-section{padding:52px 0}.related-grid{grid-template-columns:1fr}.related-card{grid-template-columns:120px 1fr;min-height:130px}.related-card div{padding:14px}.related-card h3{font-size:.9rem}}
</style>
