---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { company, services, whatsappUrl } from '../data/site.js';
const schema = { '@context':'https://schema.org', '@type':'AutomotiveBusiness', name:company.name, url:'https://mcqueenstudio.vercel.app', telephone:'+55 12 98146-0442', address:{'@type':'PostalAddress', streetAddress:'Rua Dr. Mario Sampaio Martins, 652', addressLocality:'São José dos Campos', addressRegion:'SP', postalCode:'12245-100', addressCountry:'BR'}, sameAs:[company.instagram] };
---
<BaseLayout title="Estética Automotiva em São José dos Campos" description="Mcqueen Studio Automotivo em São José dos Campos: envelopamento, PPF, polimento, vitrificação, enceramento, higienização, restauração de faróis e auto vitrais." schema={schema}>
  <section class="hero"><div class="hero-media"><div class="hero-desktop-media"><MediaSlot src="/media/hero/hero-desktop-01.jpg" alt="Foto horizontal real para o hero da Mcqueen Studio" label="Foto do hero pendente" loading="eager" /></div><video class="hero-mobile-video" src="/media/hero/hero-mobile-01.mp4" muted playsinline loop preload="metadata" aria-label="Vídeo vertical da Mcqueen Studio Automotivo"></video></div><div class="wrap hero-content"><div class="hero-kicker">Estética & personalização · SJC</div><h1>Estética Automotiva em São José dos Campos</h1><p class="hero-copy">Envelopamento, PPF, polimento, vitrificação, enceramento, higienização, restauração de faróis e auto vitrais. Serviços de estética e cuidado automotivo em São José dos Campos.</p><div class="hero-actions"><a class="button button-secondary" href="#servicos">Explorar serviços <span>↓</span></a></div></div><div class="scroll-cue">role para descobrir</div></section>
  <audio id="mcqueen-soundtrack" src="/media/musica/mixkit-carry-on-1091.mp3" autoplay preload="metadata" loop></audio>
  <button class="soundtrack-toggle" type="button" aria-label="Ativar trilha sonora" aria-pressed="false" data-soundtrack-toggle>
    <svg class="soundtrack-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 10v4h4l5 4V6l-5 4H4Z" />
      <path class="sound-wave" d="M16 9a5 5 0 0 1 0 6M18.5 6.5a8.5 8.5 0 0 1 0 11" />
      <path class="sound-off-slash" d="M4 4 20 20" />
    </svg>
    <span class="sr-only">Controle da trilha sonora</span>
  </button>
  <section class="intro-section theme-light"><div class="wrap intro-grid"><div><p class="eyebrow">01 / O estúdio</p><h2>Envelopamento,<br /><em>polimento e cuidado.</em></h2></div><div><p>A Mcqueen Studio trabalha com estética e personalização automotiva em São José dos Campos. Do envelopamento à restauração de faróis, cada serviço começa pela avaliação do veículo e pelo alinhamento do resultado esperado.</p><p>Atuação na cidade desde 2017, com serviços de estética e cuidado automotivo.</p></div></div></section>
  <section class="services-section frozen-photo-section frozen-services" style="--frozen-photo: url('/media/entrada/9F09F1C8-414F-4A6D-95F5-EAF142B64706.jpeg')" id="servicos"><div class="wrap"><div class="section-heading"><p class="eyebrow">02 / Serviços</p><h2>Serviços de estética e personalização automotiva</h2><p>Envelopamento, PPF, polimento, vitrificação, enceramento, higienização, restauração de faróis e auto vitrais.</p><a class="text-link" href="/servicos/">Ver todos os serviços <span>↗</span></a></div><div class="services-grid">{services.map((service) => <ServiceCard service={service} />)}</div></div></section>

  <section class="gallery-section frozen-photo-section frozen-projects" style="--frozen-photo: url('/media/entrada/envelopamento-do-teto.jpeg')"><div class="wrap intro-grid"><div><p class="eyebrow">03 / Projetos</p><h2>Projetos realizados<br /><em>pela Mcqueen Studio.</em></h2></div><div><p>Veja registros de envelopamento, proteção e estética automotiva em projetos realizados pela Mcqueen Studio.</p><a class="button button-secondary" href="/galeria/">Abrir galeria <span>↗</span></a></div></div></section>
  <section class="contact-section frozen-photo-section frozen-contact" style="--frozen-photo: url('/media/entrada/moto02.jpeg')"><div class="wrap contact-grid"><div><p class="eyebrow">06 / Atendimento</p><h2>Fale sobre o<br /><em>seu veículo.</em></h2></div><div><p>Informe o modelo do veículo e o serviço que procura. A equipe retorna pelo WhatsApp para orientar a avaliação e os próximos passos.</p><a class="button button-primary" href={whatsappUrl()} target="_blank" rel="noreferrer">Falar com a equipe <span>↗</span></a></div></div></section>
    <section class="reviews-section theme-light" aria-labelledby="reviews-title"><div class="wrap"><div class="section-heading"><p class="eyebrow">04 / Avaliações no <span class="google-mark google-inline" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></p><h2 id="reviews-title">A experiência de quem já passou por aqui.</h2><p><strong class="review-rating">5,0</strong> de 5 · 238 avaliações no <span class="google-mark google-inline" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></p></div><div class="reviews-viewport"><div class="reviews-track"><article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Fui com uma queimadura de soprador a qual achava que estava não tinha solução, porém a MC Queen muito profissional deixou meu farol novo de novo, excelentes profissionais da área e muito confiáveis no que faz</blockquote><div class="review-author"><strong>José de Alencar</strong><time>20 nov. 2022</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Tooooopzera de sempre! Carro estava bem sujo, ficou ótimo e os detalhes da limpeza no logo da GM, nome do carro e na revitalização dos plásticos é fora de serioooooo!!!! Muito bom sempre contar com os serviços da Mcqueen. Tks irmão Lucas pelo padrão de sempre… Será sempre recomendado por mim….</blockquote><div class="review-author"><strong>Pedro Zago</strong><time>14 dez. 2022</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Parabéns ao Lucas, da Mcqueen Estética Automotiva, excelente profissional, estou muito satisfeito com a instalação da câmera de Ré e o sensor para estacionar. Dedicação total, em cada detalhe e resposta imediata ao cliente, indico e dou nota 10.</blockquote><div class="review-author"><strong>Oliveira Reis</strong><time>21 dez. 2022</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Excelente trabalho, fui para fazer somente a plotagem do teto e limpeza, porem o mesmo ja me ajudou com problema do teto descolando internamente e fez o acompanhamento do motor falhando, alem de auxiliar em outras melhorias esteticas. O carro quando saiu, saiu outro tanto internamente quanto externamente, praticamente novo, com estiloso, cheroso e potencia. Ainda ficamos de dar continuidade ao projeto, muito bom trabalho, cuidadoso e onesto.</blockquote><div class="review-author"><strong>Kelvim wellington</strong><time>03 fev. 2023</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Quero agradecer o trabalho impecável, empresa séria e atendimento ótimo!!! Sou perfeccionista, superou minhas expectativas, ele cuida de todos os detalhes. Estou super satisfeita e super recomendo!!</blockquote><div class="review-author"><strong>Michelle Succar</strong><time>13 jun. 2023</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Carro entrou todo tristonho e saiu bonitão e cheiroso. Fui pôr o insufilme no parabrisa e no meio do caminho solicitei o polimento do capô que estava com riscos e logo de primeira virei cliente fiel, ambos os trabalhos ficaram excelentes! Recomendo demais, carro voltou todo limpinho e cheiroso por dentro, com proteção no volante até. Recomendo de olhos fechados, parabéns pelo trabalho Lucas, realmente diferenciado!</blockquote><div class="review-author"><strong>Sara Galaxe</strong><time>27 nov. 2023</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Conheci o pessoal da mcqueen no instagram, conversei com eles e foi a melhor escolha pro meu carro. Consertei infiltração no farol,fiz mascara negra, polimento e higienização. O carro ficou perfeito e o atendimento deles e ótimo o lucas sabe o que ta fazendo e passa a confiança. Indico MUITO. Parabéns a todos os envolvidos.</blockquote><div class="review-author"><strong>Vinícius Tadeu Andrade silva</strong><time>11 dez. 2023</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Fui atendido pelo Lucas e pela Júlia, ambos muito atenciosos. O serviço de envelopamento realizado no meu i30 ficou perfeito!!! Sou muito exigente aos mínimos detalhes, e posso dizer que não ficou uma única bolha para reclamar rsrs. Serviço realmente top, com produto de qualidade e muito profissionalismo na aplicação. Recomendo com certeza!!!</blockquote><div class="review-author"><strong>Marcos Vinicius</strong><time>13 fev. 2024</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Levamos a moto da minha esposa pra lavagem, estava bem castigada após uma viagem e estradas de terra. O Lucas e esposa nos receberam com muita educação e atenção às nossas necessidades desde o primeiro contato. A moto saiu como zero km. Excelência em todos os detalhes (e como são detalhistas)!!! Logo voltamos! Parabéns pessoal!!!</blockquote><div class="review-author"><strong>Willian Soler</strong><time>19 jul. 2024</time></div></article>
<article class="review-card"><div class="review-card-top"><span class="review-stars" aria-label="5 de 5 estrelas">★★★★★</span><span class="google-mark" aria-label="Google"><i>G</i><i>o</i><i>o</i><i>g</i><i>l</i><i>e</i></span></div><blockquote>Excelente trabalho! O Lucas é um profissional extremamente dedicado, atencioso e caprichoso. Dá para perceber o cuidado e a atenção que ele tem com cada detalhe do veículo. Serviço de altíssima qualidade, feito com muito profissionalismo e dedicação. Recomendo de olhos fechados para quem procura uma estética automotiva de confiança. Parabéns, Lucas, pelo excelente trabalho!</blockquote><div class="review-author"><strong>Gustavo Alcino</strong><time>28 out. 2026</time></div></article></div></div><div class="reviews-controls" aria-label="Navegação dos depoimentos"></div></div></section>
  <section class="location-section theme-light"><div class="wrap location-grid"><div><p class="eyebrow">05 / Onde estamos</p><h2>Mcqueen Studio em São José dos Campos.</h2><p>Consulte o mapa e trace sua rota até o estúdio.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Mcqueen+Studio+Automotivo+Sao+Jose+dos+Campos" target="_blank" rel="noreferrer">Abrir no Google Maps <span>↗</span></a></div><div class="map-embed"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3863.0651144961093!2d-45.88774472468127!3d-23.196262079051714!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94cc4b8f9b528b2d%3A0x6221898b04d643e9!2sMcqueen%20Studio%20Automotivo%20I%20Polimento%20I%20Envelopamento%20I%20Polimento%20em%20Farol%20I%20PPF%20I%20SJC!5e1!3m2!1spt-BR!2sbr!4v1793826591283!5m2!1spt-BR!2sbr" title="Localização da Mcqueen Studio Automotivo no Google Maps" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></div></section>
  <WhatsAppButton service="um projeto automotivo" />
  <script is:inline>
    (() => {
      const viewport = document.querySelector(".reviews-viewport");
      const track = document.querySelector(".reviews-track");
      const controls = document.querySelector(".reviews-controls");
      if (!viewport || !track) return;
      let index = 0, timer, startX = 0, dragging = false;
      const perPage = () => window.matchMedia("(max-width: 680px)").matches ? 1 : window.matchMedia("(max-width: 900px)").matches ? 2 : 3;
      const pageCount = () => Math.ceil(track.children.length / perPage());
      const buildDots = () => { controls.innerHTML = ""; for(let i=0;i<pageCount();i++){ const d=document.createElement("button"); d.className="review-dot"; d.type="button"; d.setAttribute("aria-label",`Mostrar grupo de depoimentos ${i+1}`); d.addEventListener("click",()=>{go(i);restart();}); controls.append(d); } };
      const go = (n) => { index = (n + pageCount()) % pageCount(); const card = track.children[index * perPage()]; if(card) viewport.scrollTo({left:card.offsetLeft - track.offsetLeft,behavior:"smooth"}); [...controls.children].forEach((d,i)=>d.classList.toggle("is-active",i===index)); };
      const restart = () => { clearInterval(timer); timer = setInterval(()=>go(index+1),6500); };
      buildDots();
      viewport.addEventListener("pointerdown",e=>{startX=e.clientX;dragging=true;});
      viewport.addEventListener("pointerup",e=>{if(!dragging)return;const dx=e.clientX-startX;dragging=false;if(Math.abs(dx)>45)go(index+(dx<0?1:-1));restart();});
      viewport.addEventListener("mouseenter",()=>clearInterval(timer));
      viewport.addEventListener("mouseleave",restart);
      viewport.addEventListener("touchstart",()=>clearInterval(timer),{passive:true});
      viewport.addEventListener("touchend",restart,{passive:true});
      window.addEventListener("resize",()=>{buildDots();go(index);}); restart();
    })();
  </script>
  <script is:inline>
    (() => {
      const video = document.querySelector('.hero-mobile-video');
      if (!video) return;
      let frameReady = false;
      let coverSeekStarted = false;
      const tryPlay = () => {
        if (!window.matchMedia('(max-width: 680px)').matches || document.hidden || !frameReady) return;
        video.muted = true;
        video.defaultMuted = true;
        const attempt = video.play();
        if (attempt && typeof attempt.catch === 'function') attempt.catch(() => video.classList.add('video-fallback'));
      };
      const seekToCoverFrame = () => {
        if (frameReady || coverSeekStarted || !Number.isFinite(video.duration) || video.duration < 1) return;
        coverSeekStarted = true;
        video.pause();
        video.currentTime = 1;
      };
      video.addEventListener('loadedmetadata', seekToCoverFrame);
      video.addEventListener('seeked', () => {
        if (frameReady) return;
        frameReady = true;
        video.classList.add('video-frame-ready');
        // Mostra brevemente o frame do próprio vídeo no segundo 1 antes de iniciar a reprodução.
        window.setTimeout(tryPlay, 350);
      });
      video.addEventListener('canplay', () => { if (!frameReady) seekToCoverFrame(); });
      video.addEventListener('error', () => video.classList.add('video-fallback'), { once: true });
      document.addEventListener('visibilitychange', tryPlay);
      window.addEventListener('pageshow', tryPlay);
      if (video.readyState >= 1) seekToCoverFrame();
    })();
  </script>
  <script is:inline>
    (() => {
      const audio = document.getElementById('mcqueen-soundtrack');
      const button = document.querySelector('[data-soundtrack-toggle]');
      if (!audio || !button) return;
      const targetVolume = 0.075;
      let fadeTimer = null;
      let isPlaying = false;

      const fadeTo = (target, duration, done) => {
        window.clearInterval(fadeTimer);
        const start = audio.volume;
        const steps = Math.max(1, Math.round(duration / 50));
        let step = 0;
        fadeTimer = window.setInterval(() => {
          step += 1;
          audio.volume = Math.max(0, Math.min(1, start + (target - start) * (step / steps)));
          if (step >= steps) {
            window.clearInterval(fadeTimer);
            fadeTimer = null;
            audio.volume = target;
            if (done) done();
          }
        }, 50);
      };

      const setState = (playing) => {
        isPlaying = playing;
        button.classList.toggle('is-playing', playing);
        button.setAttribute('aria-pressed', String(playing));
        button.setAttribute('aria-label', playing ? 'Desligar trilha sonora' : 'Ativar trilha sonora');
      };

      const startPlayback = async () => {
        if (isPlaying) return;
        try {
          audio.volume = 0;
          await audio.play();
          setState(true);
          fadeTo(targetVolume, 2600);
        } catch (error) {
          setState(false);
        }
      };

      // Tenta iniciar com áudio assim que a página abre.
      audio.volume = 0;
      startPlayback();

      // Se o navegador bloquear autoplay audível, inicia na primeira interação com a página.
      const unlockOnInteraction = (event) => {
        if (event.target === button || button.contains(event.target)) return;
        startPlayback();
      };
      document.addEventListener('pointerdown', unlockOnInteraction, { once: true, passive: true });
      document.addEventListener('keydown', unlockOnInteraction, { once: true });

      button.addEventListener('click', async () => {
        if (isPlaying) {
          setState(false);
          fadeTo(0, 900, () => audio.pause());
          return;
        }
        await startPlayback();
      });
      audio.addEventListener('pause', () => {
        if (audio.currentTime > 0 && audio.volume === 0) setState(false);
      });
      audio.addEventListener('ended', () => setState(false));
    })();
  </script>
</BaseLayout>
