---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaSlot from '../components/MediaSlot.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ServiceTimeline from '../components/ServiceTimeline.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { company, services, whatsappUrl } from '../data/site.js';
const schema = { '@context':'https://schema.org', '@type':'AutomotiveBusiness', name:company.name, url:'https://mcqueenstudio.com.br', telephone:'+55 12 98146-0442', address:{'@type':'PostalAddress', streetAddress:'Rua Dr. Mario Sampaio Martins, 652', addressLocality:'São José dos Campos', addressRegion:'SP', postalCode:'12245-100', addressCountry:'BR'}, sameAs:[company.instagram] };
---
<BaseLayout title="Estética Automotiva em São José dos Campos" description="Mcqueen Studio Automotivo em São José dos Campos: envelopamento, PPF, polimento, vitrificação, faróis, estética e projetos automotivos." schema={schema}>
  <section class="hero"><div class="hero-media"><div class="hero-desktop-media"><MediaSlot src="/media/hero/hero-desktop-01.jpg" alt="Foto horizontal real para o hero da Mcqueen Studio" label="Foto do hero pendente" /></div><video class="hero-mobile-video" src="/media/hero/hero-mobile-01.mp4" muted playsinline autoplay loop preload="auto" aria-label="Vídeo vertical da Mcqueen Studio Automotivo" poster="/media/hero/hero-desktop-01.jpg"></video></div><div class="wrap hero-content"><div class="hero-kicker">Estética & personalização · SJC</div><h1>Estética Automotiva em São José dos Campos</h1><p class="hero-copy">Personalização, estética e cuidado automotivo em cada detalhe. Conheça os serviços e projetos realizados pela Mcqueen Studio.</p><div class="hero-actions"><a class="button button-primary" href={whatsappUrl('um projeto automotivo')} target="_blank" rel="noreferrer">Falar pelo WhatsApp <span>↗</span></a><a class="button button-secondary" href="#servicos">Explorar serviços <span>↓</span></a></div></div><div class="scroll-cue">role para descobrir</div></section>
  <section class="intro-section"><div class="wrap intro-grid"><div><p class="eyebrow">01 / O estúdio</p><h2>Cuidado que<br /><em>aparece.</em></h2></div><div><p>Um olhar preciso para a estética e a personalidade de cada veículo. Da preparação da superfície ao último detalhe, a Mcqueen Studio constrói projetos com presença e intenção.</p><div class="stat-line"><div><strong>08</strong><span>frentes de serviço</span></div><div><strong>SJC</strong><span>São José dos Campos</span></div></div></div></div></section>
  <section class="services-section" id="servicos"><div class="wrap"><div class="section-heading"><p class="eyebrow">02 / Serviços</p><h2>Serviços de estética e personalização automotiva</h2><p>Consulte as aplicações, os cuidados e os detalhes de cada serviço oferecido pela Mcqueen Studio.</p><a class="text-link" href="/servicos/">Ver todos os serviços <span>↗</span></a></div><div class="services-grid">{services.map((service) => <ServiceCard service={service} />)}</div></div></section>
  <ServiceTimeline />
  <section class="gallery-section"><div class="wrap intro-grid"><div><p class="eyebrow">03 / Projetos</p><h2>Projetos realizados<br /><em>pela Mcqueen Studio.</em></h2></div><div><p>Veja trabalhos de envelopamento, proteção e estética automotiva na galeria. As imagens identificadas como pendentes serão substituídas por fotografias reais da equipe.</p><a class="button button-secondary" href="/galeria/">Abrir galeria <span>↗</span></a></div></div></section>
  <section class="contact-section"><div class="wrap contact-grid"><div><p class="eyebrow">04 / Conversa</p><h2>Fale sobre o<br /><em>seu veículo.</em></h2></div><div><p>Informe o modelo do veículo e o serviço que procura. A equipe retorna pelo WhatsApp para orientar a avaliação e os próximos passos.</p><a class="button button-primary" href={whatsappUrl()} target="_blank" rel="noreferrer">Olá, vim pelo site <span>↗</span></a></div></div></section>
  <WhatsAppButton service="um projeto automotivo" />
  <script is:inline>
    (() => {
      const video = document.querySelector('.hero-mobile-video');
      if (!video) return;
      const tryPlay = () => {
        if (window.matchMedia('(max-width: 680px)').matches && !document.hidden) {
          video.muted = true;
          video.defaultMuted = true;
          const attempt = video.play();
          if (attempt && typeof attempt.catch === 'function') attempt.catch(() => video.classList.add('video-fallback'));
        }
      };
      video.addEventListener('canplay', tryPlay, { once: true });
      video.addEventListener('error', () => video.classList.add('video-fallback'), { once: true });
      document.addEventListener('visibilitychange', tryPlay);
      window.addEventListener('pageshow', tryPlay);
      tryPlay();
    })();
  </script>
</BaseLayout>
