---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { company, whatsappUrl } from '../../data/site.js';
---
<BaseLayout title="Contato" description="Entre em contato com a Mcqueen Studio Automotivo pelo WhatsApp ou Instagram em São José dos Campos." path="/contato/" breadcrumbs={['Contato']}>
  <section class="service-hero"><div class="wrap"><p class="eyebrow">Contato e localização</p><h1>Mcqueen Studio em São José dos Campos</h1><p class="hero-copy">Fale com a equipe para consultar serviços, disponibilidade e avaliação do seu veículo.</p></div></section>
  <section class="contact-section"><div class="wrap contact-grid"><div><div class="contact-card"><p class="eyebrow">WhatsApp</p><h3><a href={whatsappUrl()} target="_blank" rel="noreferrer">{company.whatsappDisplay} ↗</a></h3><p>Envie o modelo do veículo e o serviço que procura.</p></div><div class="contact-card"><p class="eyebrow">Instagram</p><h3><a href={company.instagram} target="_blank" rel="noreferrer">{company.instagramHandle} ↗</a></h3><p>Referências e projetos publicados pela empresa.</p></div></div><div><div class="map-note"><p class="eyebrow">Localização</p><strong>{company.address}</strong><p>Consulte o mapa para traçar sua rota até a Mcqueen Studio.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Mcqueen+Studio+Automotivo+Sao+Jose+dos+Campos" target="_blank" rel="noreferrer">Abrir rota no Google Maps <span>↗</span></a></div><div class="map-embed"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3863.0651144961093!2d-45.88774472468127!3d-23.196262079051714!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94cc4b8f9b528b2d%3A0x6221898b04d643e9!2sMcqueen%20Studio%20Automotivo%20I%20Polimento%20I%20Envelopamento%20I%20Polimento%20em%20Farol%20I%20PPF%20I%20SJC!5e1!3m2!1spt-BR!2sbr!4v1793826591283!5m2!1spt-BR!2sbr" title="Localização da Mcqueen Studio Automotivo no Google Maps" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><div class="map-note" style="margin-top:12px"><p class="eyebrow">Reputação</p><strong>{company.rating} estrelas · {company.reviews} avaliações</strong><p>Informação do perfil do Google, sujeita a atualização.</p></div></div></div></section>
  <WhatsAppButton service="atendimento" />
</BaseLayout>
